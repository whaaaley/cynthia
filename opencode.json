{
  "$schema": "https://opencode.ai/config.json",
  "theme": "opencode",
  "instructions": [
    ".github/instructions/copilot.instructions.md",
    ".github/instructions/git.instructions.md",
    ".github/instructions/old.instructions.md",
    ".github/instructions/project.instructions.md"
  ],
  "provider": {
    "moonshot": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.moonshot.ai/v1",
        "apiKey": "{file:./.secrets/moonshot-key}"
      },
      "models": {
        "kimi-k2-0711-preview": {}
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{file:./.secrets/openrouter-key}"
      },
      "models": {}
    }
  },
  "mcp": {
    "cynthia": {
      "type": "local",
      "command": [
        "deno",
        "run",
        "-A",
        "src/mcp.ts"
      ]
    }
  },
  "mode": {
    "audit": {
      "prompt": "{file:./.github/instructions/audit.instructions.md}",
      "tools": {
        "glob": true,
        "grep": true,
        "read": true,
        "write": true
      }
    }
  },
  "permission": {
    "bash": {
      "cd*": "allow",
      "deno check*": "allow",
      "deno task test*": "allow",
      "git add*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rm*": "ask",
      "git status*": "allow",
      "grep*": "allow",
      "ls*": "allow",
      "pwd*": "allow",
      "*": "ask"
    }
  }
}
